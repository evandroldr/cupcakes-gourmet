<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= titulo %> | Cupcakes Gourmet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">
    <link href="/css/style.css" rel="stylesheet">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
      <div class="container">
        <a class="navbar-brand" href="/">Cupcakes Gourmet</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a class="nav-link" href="/">Cardápio</a>
            </li>
            <% if (usuario && usuario.perfil === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link" href="/admin/pedidos">Pedidos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/produtos">Produtos</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/estoque">Estoque</a>
            </li>
            <% } else if (usuario) { %>
            <li class="nav-item">
              <a class="nav-link" href="/pedidos">Meus pedidos</a>
            </li>
            <% } %>
          </ul>
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/carrinho">
                Carrinho
                <% if (qtdCarrinho > 0) { %>
                <span class="badge text-bg-danger rounded-pill"><%= qtdCarrinho %></span>
                <% } %>
              </a>
            </li>
            <% if (usuario) { %>
            <li class="nav-item">
              <span class="navbar-text me-lg-3">Olá, <%= usuario.nome.split(' ')[0] %></span>
            </li>
            <li class="nav-item">
              <form action="/logout" method="post">
                <button type="submit" class="nav-link">Sair</button>
              </form>
            </li>
            <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">Entrar</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/cadastro">Criar conta</a>
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
    <main class="container my-4">
      <% if (mensagem) { %>
      <div class="alert alert-<%= mensagem.tipo %> alert-dismissible fade show" role="alert">
        <%= mensagem.texto %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <% } %>

<%- include('../partials/header') %>
<h1 class="fs-2 fw-bold mb-3">Pedidos</h1>

<form class="row g-2 align-items-center mb-3" action="/admin/pedidos" method="get">
  <div class="col-auto">
    <label for="status" class="col-form-label">Status:</label>
  </div>
  <div class="col-auto">
    <select class="form-select" id="status" name="status">
      <option value="">Todos</option>
      <% Object.entries(status).forEach(([valor, item]) => { %>
      <option value="<%= valor %>" <%= filtro === valor ? 'selected' : '' %>><%= item.texto %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Filtrar</button>
  </div>
</form>

<% if (pedidos.length === 0) { %>
<div class="alert alert-info" role="alert">Nenhum pedido encontrado.</div>
<% } else { %>
<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th scope="col">Nº</th>
        <th scope="col">Data</th>
        <th scope="col">Cliente</th>
        <th scope="col">Modalidade</th>
        <th scope="col">Pagamento</th>
        <th scope="col">Total</th>
        <th scope="col">Status</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% pedidos.forEach((pedido) => { %>
      <tr>
        <td><%= pedido.id %></td>
        <td><%= dataHora(pedido.criado_em) %></td>
        <td><%= pedido.cliente %></td>
        <td><%= pedido.modalidade === 'entrega' ? 'Entrega' : 'Retirada' %></td>
        <td><%= pagamentos[pedido.forma_pagamento] %></td>
        <td><%= moeda(pedido.total) %></td>
        <td><span class="badge text-bg-<%= status[pedido.status].cor %>"><%= status[pedido.status].texto %></span></td>
        <td><a href="/admin/pedidos/<%= pedido.id %>" class="btn btn-outline-primary btn-sm">Abrir</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../partials/footer') %>

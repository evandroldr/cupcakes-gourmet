<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="fs-2 fw-bold mb-0">Produtos</h1>
  <a href="/admin/produtos/novo" class="btn btn-primary">+ Novo produto</a>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th scope="col">Imagem</th>
        <th scope="col">Nome</th>
        <th scope="col">Preço</th>
        <th scope="col">Estoque</th>
        <th scope="col">Situação</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% produtos.forEach((produto) => { %>
      <tr>
        <td><img src="<%= produto.imagem_url || '/img/sem-foto.svg' %>" alt="<%= produto.nome %>" width="60" height="45" class="rounded object-fit-cover"></td>
        <td><%= produto.nome %></td>
        <td><%= moeda(produto.preco) %></td>
        <td><%= produto.estoque %></td>
        <td>
          <% if (produto.ativo) { %>
          <span class="badge text-bg-success">Ativo</span>
          <% } else { %>
          <span class="badge text-bg-secondary">Inativo</span>
          <% } %>
        </td>
        <td><a href="/admin/produtos/<%= produto.id %>/editar" class="btn btn-outline-primary btn-sm">Editar</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

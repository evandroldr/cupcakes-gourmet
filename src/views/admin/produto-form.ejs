<%- include('../partials/header') %>
<h1 class="fs-2 fw-bold mb-3"><%= titulo %></h1>

<% if (Object.keys(erros).length > 0) { %>
<div class="alert alert-danger" role="alert">Verifique os campos destacados.</div>
<% } %>

<form action="<%= acao %>" method="post" novalidate>
  <div class="row g-3">
    <div class="col-md-6">
      <label for="nome" class="form-label">Nome *</label>
      <input type="text" class="form-control <%= erros.nome ? 'is-invalid' : '' %>" id="nome" name="nome" maxlength="100" value="<%= valores.nome || '' %>">
      <div class="invalid-feedback"><%= erros.nome %></div>
    </div>
    <div class="col-6 col-md-3">
      <label for="preco" class="form-label">Preço (R$) *</label>
      <input type="text" class="form-control <%= erros.preco ? 'is-invalid' : '' %>" id="preco" name="preco" inputmode="decimal" value="<%= typeof valores.preco === 'number' ? valores.preco.toFixed(2).replace('.', ',') : (valores.preco || '') %>">
      <div class="invalid-feedback"><%= erros.preco %></div>
    </div>
    <% if (novo) { %>
    <div class="col-6 col-md-3">
      <label for="estoque" class="form-label">Estoque inicial *</label>
      <input type="number" class="form-control <%= erros.estoque ? 'is-invalid' : '' %>" id="estoque" name="estoque" min="0" value="<%= valores.estoque %>">
      <div class="invalid-feedback"><%= erros.estoque %></div>
    </div>
    <% } %>
    <div class="col-md-6">
      <label for="descricao" class="form-label">Descrição *</label>
      <textarea class="form-control <%= erros.descricao ? 'is-invalid' : '' %>" id="descricao" name="descricao" rows="3"><%= valores.descricao || '' %></textarea>
      <div class="invalid-feedback"><%= erros.descricao %></div>
    </div>
    <div class="col-md-6">
      <label for="ingredientes" class="form-label">Ingredientes *</label>
      <textarea class="form-control <%= erros.ingredientes ? 'is-invalid' : '' %>" id="ingredientes" name="ingredientes" rows="3"><%= valores.ingredientes || '' %></textarea>
      <div class="invalid-feedback"><%= erros.ingredientes %></div>
    </div>
    <div class="col-md-6">
      <label for="alergenicos" class="form-label">Alergênicos</label>
      <input type="text" class="form-control" id="alergenicos" name="alergenicos" maxlength="255" placeholder="Ex.: glúten, ovos, leite" value="<%= valores.alergenicos || '' %>">
    </div>
    <div class="col-md-6">
      <label for="imagem_url" class="form-label">Link da imagem</label>
      <input type="url" class="form-control" id="imagem_url" name="imagem_url" maxlength="255" placeholder="https://..." value="<%= valores.imagem_url || '' %>">
    </div>
    <div class="col-12">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="ativo" name="ativo" <%= valores.ativo ? 'checked' : '' %>>
        <label class="form-check-label" for="ativo">Produto ativo no catálogo</label>
      </div>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a href="/admin/produtos" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>

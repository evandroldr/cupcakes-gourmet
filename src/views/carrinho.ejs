<%- include('partials/header') %>
<h1 class="fs-2 fw-bold mb-4">Meu carrinho</h1>

<% if (itens.length === 0) { %>
<div class="alert alert-info" role="alert">
  Seu carrinho está vazio. <a href="/" class="alert-link">Ver cardápio</a>
</div>
<% } else { %>
<div class="row g-4">
  <div class="col-lg-8">
    <% itens.forEach((item) => { %>
    <div class="card mb-3">
      <div class="row g-0">
        <div class="col-3 col-md-2">
          <img src="<%= item.imagem_url || '/img/sem-foto.svg' %>" class="img-fluid rounded-start h-100 object-fit-cover" alt="<%= item.nome %>">
        </div>
        <div class="col-9 col-md-10">
          <div class="card-body">
            <h5 class="card-title"><%= item.nome %></h5>
            <p class="card-text text-primary fw-bold mb-2"><%= moeda(item.preco) %> <small class="text-body-secondary fw-normal">cada</small></p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <form action="/carrinho/atualizar" method="post" class="d-flex gap-2">
                <input type="hidden" name="produtoId" value="<%= item.id %>">
                <input type="number" class="form-control form-control-sm" name="quantidade" value="<%= item.quantidade %>" min="1" max="<%= item.estoque %>" style="max-width: 80px" aria-label="Quantidade">
                <button type="submit" class="btn btn-outline-primary btn-sm">Atualizar</button>
              </form>
              <form action="/carrinho/remover" method="post" onsubmit="return confirm('Deseja remover este item do carrinho?')">
                <input type="hidden" name="produtoId" value="<%= item.id %>">
                <button type="submit" class="btn btn-link btn-sm text-danger">Remover</button>
              </form>
              <span class="ms-auto fw-bold"><%= moeda(item.subtotal) %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="col-lg-4">
    <div class="card bg-body-tertiary">
      <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
          <span>Subtotal</span>
          <span><%= moeda(total) %></span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Entrega</span>
          <span class="text-success fw-bold">Grátis</span>
        </div>
        <hr>
        <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
          <span>Total</span>
          <span class="text-primary"><%= moeda(total) %></span>
        </div>
        <a href="/checkout" class="btn btn-primary w-100 mb-2">Finalizar pedido</a>
        <a href="/" class="btn btn-outline-primary w-100">Continuar comprando</a>
      </div>
    </div>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>

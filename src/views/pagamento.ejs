<%- include('partials/header') %>
<% const descricoes = { pix: 'QR Code no caixa da loja', cartao: 'Crédito ou débito na maquininha', dinheiro: 'Pagamento em espécie' } %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="fs-2 fw-bold mb-1">Finalizar pedido</h1>
    <p class="text-body-secondary mb-4">Etapa 2 de 2: pagamento</p>

    <form action="/pedidos" method="post">
      <h2 class="fs-5 fw-bold">Forma de pagamento</h2>
      <% Object.entries(pagamentos).forEach(([valor, nome]) => { %>
      <div class="form-check border rounded p-3 ps-5 mb-2">
        <input class="form-check-input" type="radio" name="formaPagamento" id="<%= valor %>" value="<%= valor %>">
        <label class="form-check-label" for="<%= valor %>">
          <span class="fw-bold"><%= nome %></span><br>
          <small class="text-body-secondary"><%= descricoes[valor] %></small>
        </label>
      </div>
      <% }) %>

      <div class="alert alert-warning mt-3" role="alert">O pagamento é feito na loja ou na entrega.</div>

      <h2 class="fs-5 fw-bold mt-4">Resumo do pedido</h2>
      <div class="card bg-body-tertiary mb-3">
        <div class="card-body">
          <% itens.forEach((item) => { %>
          <div class="d-flex justify-content-between mb-1">
            <span><%= item.quantidade %>x <%= item.nome %></span>
            <span><%= moeda(item.subtotal) %></span>
          </div>
          <% }) %>
          <div class="d-flex justify-content-between mb-1">
            <span>Entrega</span>
            <span class="text-success fw-bold">Grátis</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between fs-5 fw-bold">
            <span>Total</span>
            <span class="text-primary"><%= moeda(total) %></span>
          </div>
          <hr>
          <% if (checkout.modalidade === 'entrega' && endereco) { %>
          <p class="mb-0 small">Entrega em: <%= endereco.logradouro %>, <%= endereco.numero %> - <%= endereco.bairro %> - <%= endereco.cidade %>/<%= endereco.estado %></p>
          <% } else { %>
          <p class="mb-0 small">Retirada na loja em <%= dataHora(checkout.dataRetirada) %></p>
          <% } %>
        </div>
      </div>

      <button type="submit" class="btn btn-success btn-lg w-100">Confirmar pedido</button>
      <a href="/checkout" class="btn btn-link w-100">Voltar</a>
    </form>
  </div>
</div>
<%- include('partials/footer') %>

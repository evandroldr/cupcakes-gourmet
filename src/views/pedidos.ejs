<%- include('partials/header') %>
<h1 class="fs-2 fw-bold mb-4">Meus pedidos</h1>

<% if (pedidos.length === 0) { %>
<div class="alert alert-info" role="alert">
  Você ainda não fez nenhum pedido. <a href="/" class="alert-link">Ver cardápio</a>
</div>
<% } %>

<div class="list-group">
  <% pedidos.forEach((pedido) => { %>
  <a href="/pedidos/<%= pedido.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
    <div>
      <div class="fw-bold">Pedido nº <%= pedido.id %></div>
      <small class="text-body-secondary"><%= dataHora(pedido.criado_em) %> - <%= pedido.modalidade === 'entrega' ? 'Entrega' : 'Retirada' %></small>
      <div class="text-primary fw-bold"><%= moeda(pedido.total) %></div>
    </div>
    <span class="badge text-bg-<%= status[pedido.status].cor %>"><%= status[pedido.status].texto %></span>
  </a>
  <% }) %>
</div>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="fs-2 fw-bold mb-1">Finalizar pedido</h1>
    <p class="text-body-secondary mb-4">Etapa 1 de 2: entrega</p>

    <form action="/checkout" method="post">
      <div class="btn-group w-100 mb-4" role="group" aria-label="Modalidade">
        <input type="radio" class="btn-check" name="modalidade" id="entrega" value="entrega" autocomplete="off" checked>
        <label class="btn btn-outline-primary" for="entrega">Entrega</label>
        <input type="radio" class="btn-check" name="modalidade" id="retirada" value="retirada" autocomplete="off">
        <label class="btn btn-outline-primary" for="retirada">Retirada na loja</label>
      </div>

      <div id="area-entrega">
        <% if (enderecos.length > 0) { %>
        <h2 class="fs-5 fw-bold">Endereço salvo</h2>
        <% enderecos.forEach((endereco, i) => { %>
        <div class="form-check border rounded p-3 ps-5 mb-2">
          <input class="form-check-input" type="radio" name="enderecoId" id="endereco<%= endereco.id %>" value="<%= endereco.id %>" <%= i === 0 ? 'checked' : '' %>>
          <label class="form-check-label" for="endereco<%= endereco.id %>">
            <%= endereco.logradouro %>, <%= endereco.numero %> <%= endereco.complemento %><br>
            <small class="text-body-secondary"><%= endereco.bairro %> - <%= endereco.cidade %>/<%= endereco.estado %> - CEP <%= endereco.cep %></small>
          </label>
        </div>
        <% }) %>
        <div class="form-check border rounded p-3 ps-5 mb-3">
          <input class="form-check-input" type="radio" name="enderecoId" id="enderecoNovo" value="novo">
          <label class="form-check-label" for="enderecoNovo">Usar um novo endereço</label>
        </div>
        <% } else { %>
        <input type="hidden" name="enderecoId" value="novo">
        <% } %>

        <div id="novo-endereco" class="<%= enderecos.length > 0 ? 'd-none' : '' %>">
          <h2 class="fs-5 fw-bold">Novo endereço</h2>
          <div class="row g-3">
            <div class="col-5">
              <label for="cep" class="form-label">CEP</label>
              <input type="text" class="form-control" id="cep" name="cep" placeholder="00000-000" maxlength="9">
            </div>
            <div class="col-7">
              <label for="numero" class="form-label">Número</label>
              <input type="text" class="form-control" id="numero" name="numero" maxlength="10">
            </div>
            <div class="col-12">
              <label for="logradouro" class="form-label">Rua</label>
              <input type="text" class="form-control" id="logradouro" name="logradouro" maxlength="150">
            </div>
            <div class="col-12">
              <label for="complemento" class="form-label">Complemento</label>
              <input type="text" class="form-control" id="complemento" name="complemento" placeholder="Apto, bloco" maxlength="100">
            </div>
            <div class="col-md-5">
              <label for="bairro" class="form-label">Bairro</label>
              <input type="text" class="form-control" id="bairro" name="bairro" maxlength="100">
            </div>
            <div class="col-8 col-md-5">
              <label for="cidade" class="form-label">Cidade</label>
              <input type="text" class="form-control" id="cidade" name="cidade" maxlength="100">
            </div>
            <div class="col-4 col-md-2">
              <label for="estado" class="form-label">UF</label>
              <input type="text" class="form-control" id="estado" name="estado" maxlength="2">
            </div>
          </div>
        </div>

        <div class="alert alert-success mt-4" role="alert">Taxa de entrega: <strong>Grátis</strong></div>
      </div>

      <div id="area-retirada" class="d-none">
        <div class="alert alert-info" role="alert">Retire na loja: Av. Paulista, 1000 - Bela Vista - São Paulo/SP</div>
        <div class="row g-3">
          <div class="col-6">
            <label for="data" class="form-label">Data da retirada</label>
            <input type="date" class="form-control" id="data" name="data">
          </div>
          <div class="col-6">
            <label for="hora" class="form-label">Horário</label>
            <input type="time" class="form-control" id="hora" name="hora">
          </div>
        </div>
        <p class="text-body-secondary small mt-2">Atendimento: segunda a sábado, das 9h às 19h.</p>
      </div>

      <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Continuar</button>
      <a href="/carrinho" class="btn btn-link w-100">Voltar ao carrinho</a>
    </form>
  </div>
</div>

<script>
  const areaEntrega = document.getElementById('area-entrega');
  const areaRetirada = document.getElementById('area-retirada');
  const novoEndereco = document.getElementById('novo-endereco');

  document.querySelectorAll('input[name="modalidade"]').forEach((opcao) => {
    opcao.addEventListener('change', () => {
      const retirada = opcao.value === 'retirada';
      areaEntrega.classList.toggle('d-none', retirada);
      areaRetirada.classList.toggle('d-none', !retirada);
    });
  });

  document.querySelectorAll('input[name="enderecoId"][type="radio"]').forEach((opcao) => {
    opcao.addEventListener('change', () => {
      novoEndereco.classList.toggle('d-none', opcao.value !== 'novo');
    });
  });
</script>
<%- include('partials/footer') %>
